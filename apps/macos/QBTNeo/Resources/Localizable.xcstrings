    "Affects certificate validation and non-torrent protocol activities (e.g. RSS feeds, program updates, torrent files, geoip db, etc)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤثر على التحقق من الشهادات وأنشطة البروتوكولات غير المتعلقة بالتورنت (مثل خلاصات RSS، تحديثات البرامج، ملفات التورنت، قاعدة بيانات geoip، إلخ)."
          }
        },
        "az-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Sertifikatın doğrulanmasına və qeyri-torrent protokol fəaliyyətlərinə təsir göstərir (məs., RSS lentləri, proqram yenilənmələri, torrent faylları, GeoİP məlumatları, və sair)"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiče na validaciju certifikata i aktivnosti protokola koji nisu vezani za torrent (npr. RSS feedove, ažuriranja programa, torrent datoteke, geoip bazu podataka itd.)"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afecta la validació de certificats i les activitats de protocol que no són de torrents (per exemple, fonts RSS, actualitzacions de programes, fitxers torrent, bases de dades geoip, etc.)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Má vliv na ověření certifikátu a aktivity protokolů jiných než je bittorrent (např. RSS kanály, aktualizace programu, soubory torrentů, GEOIP databáze, atd.)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beeinflusst die Zertifikatsvalidierung und Aktivitäten außerhalb des Torrent-Protokolls (z. B. RSS-Feeds, Programmaktualisierungen, Torrent-Dateien, GeoIP-DB usw.)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επηρεάζει την επικύρωση πιστοποιητικών και και δραστηριότητες πρωτοκόλλων που δεν αφορούν στα torrent (π.χ. ροές RSS, ενημερώσεις πριγράμματος, αρχεία torrent, geoip db, κλπ)"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Affects certificate validation and non-torrent protocol activities (e.g. RSS feeds, program updates, torrent files, geoip db, etc)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Afecta la validación de certificados y las actividades de protocolos que no son torrent (por ejemplo, feeds RSS, actualizaciones de programas, archivos torrent, base de datos geoip, etc.)"
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziurtagirien baliozkotzeari eta torrenten kanpoko protokolo-jarduerei eragiten die (adibidez, RSS jarioak, programen eguneraketak, torrent fitxategiak, geoip db, etab.)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affecte la validation des certificats et les activités du protocole non torrent (p. ex. les flux RSS, les mises à jour de programmes, les fichiers torrent, la base de données geoip, etc.)"
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afecta á validación de certificados e ás actividades de protocolos non-torrent (por exemplo, feeds RSS, actualizacións do programa, ficheiros torrent, base de datos geoip, etc)."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utječe na provjeru valjanosti certifikata i aktivnosti ne-torrent protokola (npr. RSS feedove, ažuriranja programa, torrent datoteke, geoip db, itd.)"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatással van a tanúsítványok ellenőrzésére és a nem torrent protokollal végzett tevékenységekre (pl. RSS-hírcsatornák, programfrissítések, torrent fájlok, geoip adatbázis stb.)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Influisce sulla convalida del certificato e sulle attività del protocollo non torrent (ad esempio feed RSS, aggiornamenti programma, file torrent, db geoip, ecc.)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "証明書の検証とtorrentプロトコル以外のアクティビティ (RSSフィード、プログラムの更新、torrentファイル、geoip dbなど) に影響します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증서 유효성 검사 및 비 토렌트 프로토콜 활동(예: RSS 피드, 프로그램 업데이트, 토렌트 파일, geoip db 등)에 영향을 미칩니다."
          }
        },
        "lv-LV": {
          "stringUnit": {
            "state": "translated",
            "value": "Ietekmē sertifikātu validāciju un ne-torrentu protokolu darbības (piem., RSS plūsmas, programmas atjauninājumus, torrentu failus, geoip db utt.)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Påvirker sertifikatvalidering  og protokollaktivitet utenom torrent (f.eks. RSS, programoppdateringer, torrent-filer, geoip-baser, osv.)"
          }
        },
        "ne-NP": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रमाणपत्र प्रमाणीकरण र गैर-टोरेन्ट प्रोटोकल गतिविधिहरूलाई असर गर्छ (जस्तै RSS फिडहरू, प्रोग्राम अपडेटहरू, टोरेन्ट फाइलहरू, geoip db, आदि)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Van invloed op certificaatvalidatie en niet-torrent-protocol-activiteiten (bijv. RSS-feeds, programma-updates, torrentbestanden, geoip db, enz.)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotyczy walidacji certyfikatów i działań niezwiązanych z protokołami torrent (np. kanałów RSS, aktualizacji programów, plików torrent, bazy danych geoip itp.)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Afeta a validação de certificados e atividades de protocolo não torrent (por exemplo, feeds RSS, atualizações de programas, arquivos torrent, banco de dados geoip, etc.)"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Afeta a validação de certificados e atividades que não utilizam o protocolo torrent (ex.: feeds RSS, atualizações do programa, ficheiros torrent, base de dados GeoIP, etc.)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Затрагивает проверку сертификатов и деятельность, не связанную с протоколом торрент (например, RSS-ленты, обновления программы, торрент-файлы, БД GeoIP и т. д.)"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Má vplyv na overenie certifikátu a aktivity iných protokolov než bittorrent (napr. RSS kanály, aktualizácie aplikácie, torrent súbory, GeoIP databáza, atď.)"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Утиче на валидацију сертификата и активности протокола који нису везани за торент (нпр. RSS фидове, ажурирања програма, торент датотеке, geoip базу података итд.)"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiče na validaciju sertifikata i aktivnosti protokola koji nisu vezani za torent (npr. RSS fidove, ažuriranja programa, torent datoteke, geoip bazu podataka itd.)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Påverkar certifikatvalidering och icke-torrentprotokollaktiviteter (t.ex. RSS-flöden, programuppdateringar, torrentfiler, geoip db, etc)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งผลต่อการตรวจสอบใบรับรอง และกิจกรรมที่ไม่ใช่โพรโทคอลทอร์เรนต์ (เช่น RSS feeds, การอัปเดตโปรแกรม, ไฟล์ทอร์เรนต์, ฐานข้อมูล GeoIP, และอื่นๆ)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sertifika doğrulamayı ve torrent dışı protokol etkinliklerini etkiler (örn. RSS bildirimleri, program güncellemeleri, torrent dosyaları, geoip veritabanı vb.)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Включає перевірку сертифікатів і діяльність, не пов'язану з протоколом торрент (наприклад, RSS-стрічки, оновлення програми, торрент-файли, БД GeoIP і т. д.)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh hưởng đến việc xác thực chứng chỉ và các hoạt động giao thức không phải torrent (ví dụ: nguồn cấp dữ liệu RSS, cập nhật chương trình, tệp torrent, db địa lý, v.v.)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "影响证书验证和非 torrent 协议活动（如 RSS 源、程序更新、torrent 文件、geoip 数据库等）"
          }
        },
        "zh-Hant": {
