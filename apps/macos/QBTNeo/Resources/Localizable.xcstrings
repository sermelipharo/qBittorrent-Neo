        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Znovu oznámiť všetkým trackerom pri zmene IP alebo portu"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znova sporoči vsem sledilnikom, ko se spremeni IP ali vrata"
