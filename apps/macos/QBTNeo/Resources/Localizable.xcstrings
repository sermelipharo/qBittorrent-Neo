          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode separar os grupos/filas de trackers com uma linha vazia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puteți separa nivelurile/grupurile de urmăritoare cu o linie goală."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте пустые строки для разделения уровней / групп трекеров."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skupiny / úrovne trackerov môžete oddeliť prázdnym riadkom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopnje / skupine sledilnika lahko ločite s prazno vrstico."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Можете раздвојити нивое/групе праћења празном линијом."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Možete razdvojiti nivoe/grupe praćenja praznom linijom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan separera spårarnivåer / grupper med en tom rad."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzleyici katmanlarını / gruplarını boş bir satırla ayırabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
