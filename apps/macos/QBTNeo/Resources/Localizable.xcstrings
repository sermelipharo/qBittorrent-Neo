          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit erottaa seurantapalvelinten tasot/ryhmät tyhjällä rivillä"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
