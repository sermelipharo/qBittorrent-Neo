        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Шлях да папкі, за якой трэба сачыць, не можа быць пустым."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пътя на наблюдаваната папка не може да бъде празен."
