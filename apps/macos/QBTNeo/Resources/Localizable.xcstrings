        }
      }
    },
    "The WebUI password must be at least 6 characters long.": {
      "localizations": {
        "az-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Veb İİ şifrəsi ən az 6 işarədən ibarət olmalıdır."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароль вэб-інтэрфейсу павінен змяшчаць не менш за 6 сімвалаў."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Lozinka za WebUI mora imati najmanje 6 znakova."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La contrasenya de la interfície web ha de tenir almenys 6 caràcters."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Heslo WebUI musí mít délku nejméně 6 znaků."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Passwort für das Webinterface muss mindestens 6 Zeichen lang sein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο κωδικός πρόσβασης WebUI πρέπει να αποτελείται από τουλάχιστον 6 χαρακτήρες."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "The WebUI password must be at least 6 characters long."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The WebUI password must be at least 6 characters long."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La contraseña de WebUI debe tener al menos 6 caracteres."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "WebUI parooli pikkus peab olema vähemalt 6 tähemärki."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "WebUI pasahitzak 6 karaktere izan behar ditu gutxienez."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "The WebUI salasana täytyy olla at least 6 characters long."
          }
        },
