    "Category name cannot contain '\\'.\nCategory name cannot start/end with '/'.\nCategory name cannot contain '//' sequence.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسم الفئة لا يمكن أن يحتوي على '\\'.\nاسم الفئة لا يمكن أن يبدأ أو ينتهي بـ '/'.\nاسم الفئة لا يمكن أن يحتوي على '//'."
          }
        },
        "az-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Kateqoriya adında '\\' ola bilməz\nKateqoriya adı '/' ilə başlaya və bitə bilməz\nKateqoriya adında '//' ardıcıllığı ola bilməz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Назва катэгорыі не можа змяшчаць «\\».\nНазва катэгорыі не можа пачынацца з «/» ці заканчвацца на «/».\nНазва катэгорыі не можа змяшчаць «//»."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Името на категория не трябва да съдържа '\\'.\nИмето на категория не трябва да започва/завършва с '/'.\nИмето на категория не трябва съдържа '//' последователност."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Naziv kategorije ne može sadržavati '\\'.\nNaziv kategorije ne može počinjati/završavati sa '/'.\nNaziv kategorije ne može sadržavati niz '//'."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El nom de la categoria no pot incluore \"\\\".\nEl nom de la categoria no pot començar ni acabar amb \"/\".\nEl nom de la categoria no pot incloure la seqüència \"//\"."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Název kategorie nemůže obsahovat znak '\\'.\nNázev kategorie nemůže začínat/končit znakem '/'.\nNázev kategorie nemůže obsahovat sekvenci znaků '//'."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorinavn må ikke indeholde '\\'.\nKategorinavn må ikke begynde/slutte med '/'.\nKategorinavn må ikke indeholde '//'-sekvens."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kategoriename darf kein „\\“ enthalten.\nDer Kategoriename darf nicht mit „/“ beginnen oder enden.\nDer Kategoriename darf die Zeichenkette „//“ nicht enthalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το όνομα της κατηγορίας δεν μπορεί να περιέχει '\\'.\nΤο όνομα της κατηγορίας δεν μπορεί να ξεκινά/τελειώνει με '/'.\nΤο όνομα της κατηγορίας δεν μπορεί να περιέχει αλληλουχία '//'."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Category name cannot contain '\\'.\nCategory name cannot start/end with '/'.\nCategory name cannot contain '//' sequence."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Category name cannot contain '\\'.\nCategory name cannot start/end with '/'.\nCategory name cannot contain '//' sequence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre de la categoría no debe contener '\\'\nEl nombre de la categoría no debe contener '//'\nEl nombre de la categoría no debe comenzar o terminar con '/'."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategooria nimi ei tohi sisaldada '\\'.\nKategooria nimi ei tohi algada/lõppeda märgiga '/'.\nKategooria nimi ei tohi sisaldada '//' järjestust."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategoria izenak ezin du '\\' izan.\nKategoria izena ezin da '/'-rekin hasi/amaitu.\nKategoria izenak ezin du '//' sekuentzia izan."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نام دسته نمی تواند حاوی \"\\\" باشد.\nنام دسته نمی تواند با \"/\" شروع/پایان یابد.\nنام دسته نمی تواند حاوی دنباله \"//\" باشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom de catégorie ne peut contenir de '\\'.\nLe nom de catégorie ne peut commencer/finir par '/'.\nLe nom de catégorie ne peut contenir la séquence '//'."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome da categoría non debe conter «\\».\nO nome da categoría non debe comezar/rematar con «/»\nO nome da categoría non debe conter a secuencia «//»."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שם קטגוריה אינו יכול להכיל '\\'.\nשם קטגוריה אינו יכול להתחיל או להסתיים ב־'/'.\nשם קטגוריה אינו יכול להכיל רצף '//'."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Naziv kategorije ne može sadržavati '\\'.\nNaziv kategorije ne može započeti/završiti s '/'.\nNaziv kategorije ne može sadržavati niz '//'."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kategórianév nem tartalmazhat '\\' karaktert.\nA kategórianév nem kezdődhet/végződhet '/' karakterrel.\nA kategórianév nem tartalmazhatja a '//' karaktersorozatot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama kategori tidak bisa mengandung '\\'.\nNama kategori tidak bisa dimulai/diakhiri oleh '/'.\nNama kategori tidak bisa '//' barisan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome categoria non può contenere '\\'.\nIl nome categoria non può iniziare/finire con '/'.\nIl nome categoria non può contenere la sequenza '//'."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カテゴリ名に'\\'を含めることはできません。\nカテゴリ名は'/'で開始または終了することはできません。\nカテゴリ名に'//'の並びを含めることはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "범주 이름은 '\\'를 포함할 수 없습니다.\n범주 이름은 '/'로 시작하거나 끝날 수 없습니다.\n범주 이름은 연속된 '//'를 포함할 수 없습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorijos pavadinime negali būti \"\\\".\nKategorijos pavadinimas negali prasidėti/užsibaigti simboliu \"/\".\nKategorijos pavadinime negali būti \"//\" sekos."
          }
        },
        "lv-LV": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorijas nosaukums nedrīkst saturēt '\\'.\nKategorijas nosaukums nedrīkst sākties vai beigties ar '/'.\nKategorijas nosaukums nedrīkst saturēt '//' simbolus."
          }
        },
        "ms-MY": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama kategori tidak boleh mengandungi '\\'.\nNama kategori tidak boleh bermula/tamat dengan '/'.\nNama kategori tidak boleh mengandungi jujukan '//'."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorinavn kan ikke inneholde '\\'.\nKategorinavn kan ikke starte/slutte med '/'.\nKategorinavn kan ikke inneholde en '//'-sekvens."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Categorienaam mag geen '\\' bevatten.\nCategorienaam mag niet beginnen/eindigen met '/'.\nCategorienaam mag de '//'-opeenvolging niet bevatten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa kategorii nie może zawierać '\\'.\nNazwa kategorii nie może się rozpoczynać/kończyć '/'.\nNazwa kategorii nie może zawierać sekwencji '//'."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome da categoria não pode conter '\\'.\nO nome da categoria não pode iniciar/terminar com '/'.\nO nome da categoria não pode conter a sequência '//'."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome da categoria não pode conter '\\'.\nO nome da categoria não pode iniciar/terminar com '/'.\nO nome da categoria não pode conter a sequência '//'."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Denumirea categoriei nu poate să conțină „\\”.\nDenumirea categoriei nu poate să înceapă/sfârșească cu „/”.\nDenumirea categoriei nu poate să conțină secvența „//”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя категории не должно содержать «\\».\nИмя категории не должно начинаться или заканчиваться с «/».\nИмя категории не должно содержать «//»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Názov kategórie nesmie obsahovať znak '\\'.\nNázov kategóre nesmie začínať ani končiť znakom '/'.\nNázov kategórie nesmie obsahovať postupnosť znakov '//'."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ime kategorije ne sme vsebovati '\\'.\nIme kategorije se ne sme začeti/končati z '/'.\nIme kategorije ne sme vsebovati zaporedja '//'."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Назив категорије не сме да садржи '\\'.\nНазив категорије не сме да почиње/завршава се са '/'.\nНазив категорије не сме да садржи низ '//'."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Naziv kategorije ne sme da sadrži '\\'.\nNaziv kategorije ne sme da počinje/završava se sa '/'.\nNaziv kategorije ne sme da sadrži niz '//'."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorinamnet kan inte innehålla \"\\\".\nKategorinamnet kan inte börja/sluta med \"/\".\nKategorinamnet kan inte innehålla sekvensen \"//\"."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อหมวดหมู่จะต้องไม่มี '\\'.\nชื่อหมวดหมู่ไม่สามารถขึ้นต้นหรือลงท้ายด้วย '/'.\nอหมวดหมู่จะต้องไม่มี '//' ลำดับ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategori adı '\\' içeremez.\nKategori adı '/' ile başlayamaz/bitemez.\nKategori adı '//' şeklinde dizi içeremez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назва категорії не може містити '\\'.\nНазва категорії не може починатися/закінчуватись на '/'.\nНазва категорії не може містити послідовність '//'."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên danh mục không được chứa '\\'.\nTên danh mục không được bắt đầu/kết thúc với '/'.\nTên danh mục không được chứa chuỗi '//'."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "分類名不可包含「\\」。\n分類名不可使用「/」作開頭或結尾。\n分類名不可包含「//」。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分类名称不能包含 \"\\\"。\n分类名称不能以 \"/\" 开头/结尾。\n分类名称不能包含 \"//\" 序列。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分類名稱不應該包含「\\」。\n分類名稱不應該以「/」開始或結束。\n分類名稱不應該包含「//」序列。"
          }
        }
      }
    },
    "Category with the given name already exists.\nPlease choose a different name and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوجد فئة بهذا الاسم بالفعل.\nرجاءً اختر اسمًا مختلفًا وحاول مجددًا."
          }
        },
        "az-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Verilmiş adla kateqoriya artıq mövcuddur.\nBaşqa ad verin və yenidən cəhd edin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Катэгорыя з такой назвай ужо існуе.\nВыберыце іншую назву і паспрабуйце яшчэ."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Правило с това име вече съществува.\nМоля изберете друго име и опитайте отново."
          }
        },
