    "Rotate this API key? The current key will immediately stop working and a new key will be generated.": {
      "localizations": {
        "az-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu API açarı döndərək? Bu açarın işləməsi dərhal dayandırılacaq və yeni bir açar yaradılacaq."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Замяніць гэты ключ API? Будзе створаны новы ключ, а бягучы адразу ж перастане працаваць."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamijenite ovaj API ključ? Trenutni odmah prestaje raditi, novi će biti generisan"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Voleu girar aquesta clau d'API? La clau actual deixarà de funcionar immediatament i se'n generarà una de nova."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahradit tento API klíč? Současný klíč přestane fungovat okamžitě a bude vytvořen nový klíč."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen API-Schlüssel ändern? Der aktuelle Schlüssel wird nicht mehr funktionieren und ein neuer Schlüssel wird erstellt."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotate this API key? The current key will immediately stop working and a new key will be generated."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Desea cambiar esta clave API? La clave actual dejará de funcionar inmediatamente y se generará una nueva."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotate this API avain? The current avain will immediately stop working and a new avain will be generated."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effectuer une rotation de cette clé API ? La clé actuelle cessera immédiatement de fonctionner et une nouvelle clé sera générée."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Xirar esta clave API? A clave actual deixará de funcionar inmediatamente e xerarase unha nova clave."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotirati ovaj API ključ? Trenutni ključ odmah prestaje raditi i generirat će se novi ključ."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Forgatja ezt az API-kulcsot? A jelenlegi kulcs azonnal megszűnik működni, és egy új kulcs lesz generálva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi ruotare questa chiave API? \nLa chiave attuale smetterà immediatamente di funzionare e verrà generata una nuova chiave."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 키를 변경하시겠습니까? 현재 키는 즉시 작동을 멈추고 새 키가 생성됩니다."
          }
        },
        "ne-NP": {
          "stringUnit": {
            "state": "translated",
            "value": "यो API कुञ्जी घुमाउने हो? हालको कुञ्जीले तुरुन्तै काम गर्न छोड्नेछ र नयाँ कुञ्जी उत्पन्न हुनेछ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze API-sleutel wijzigen? De huidige sleutel werkt dan niet meer en er wordt een nieuwe sleutel gegenereerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastąpić ten klucz API? Obecny klucz natychmiast przestanie działać i zostanie wygenerowany nowy."
          }
        },
