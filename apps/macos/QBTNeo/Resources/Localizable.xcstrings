          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Biztos benne, hogy engedélyezi az automatikus torrentkezelést a kiválasztott torrent(ek) számára? Lehetséges, hogy át lesznek helyezve."
