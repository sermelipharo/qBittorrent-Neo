        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Reanunciar para todos os trackers quando o IP ou porta forem alterados"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reanunță toate urmăritoarele când se schimbă IP-ul sau portul"
