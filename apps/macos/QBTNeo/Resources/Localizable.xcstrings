          "stringUnit": {
            "state": "translated",
            "value": "הגדר אל 0 כדי לתת למערכת שלך לבחור פתחה שאינה בשימוש"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Postavite na 0 kako bi vaš sustav odabrao neiskorišteni port"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Állítsa 0 -ra, hogy a rendszer válasszon egy nem használt portot"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta a 0 per consentire al sistema di scegliere una porta non usata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "0に設定すると、システムが未使用のポートを選択します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템이 사용하지 않는 포트를 선택하도록 하려면 0으로 설정하십시오"
          }
        },
        "lv-LV": {
          "stringUnit": {
            "state": "translated",
            "value": "Izvēlies 0, ja vēlies, lai sistēma izvēlas neizmantotu portu"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sett lik 0 for å la systemet velge en port som ikke brukes"
          }
        },
        "ne-NP": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंको सिस्टमलाई प्रयोग नगरिएको पोर्ट छनौट गर्न दिन 0 मा सेट गर्नुहोस्"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instellen op 0 om uw systeem een ongebruikte poort te laten kiezen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw na 0, aby system mógł wybrać nieużywany port"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina em 0 pra deixar seu sistema escolher uma porta não usada"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Definir para 0 para deixar o seu sistema escolher uma porta não utilizada"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Setează ca 0 pentru a lăsa sistemul să folosească un port neutilizat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите «0» для подбора системой неиспользуемого порта"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavte na 0, aby váš systém vybral nepoužívaný port"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavite na 0, da prepustite sistemu izbiro neuporabljenih vrat"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Vendos në 0 për të lënë sistemin tënd të zgjedhë një portë të papërdorur"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Подесите на 0 да би систем сам изабрао слободан порт"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Podesite na 0 da bi sistem sam izabrao slobodan port"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange 0 för att låta systemet välja en ledig port"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisteminizin kullanılmayan bir bağlantı noktası seçmesine izin vermek için 0 olarak ayarlayın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Встановіть рівним 0, щоб дозволити системі вибрати якийсь невикористаний порт"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt là 0 để hệ thống chọn một cổng không sử dụng"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "設定為 0 讓您的系統挑選未使用的通訊埠"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设为 0，让系统选择一个未使用的端口"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定為 0 讓您的系統挑選未使用的連接埠"
          }
        }
      }
    },
    "Sets the timeout for the session to be shut down gracefully, at which point it will be forcibly terminated. Note that this does not apply to the saving resume data time.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задаёт время ожидания корректного завершения сессии, по истечении которого она будет принудительно завершена. Не относится ко времени сохранения данных возобновления."
          }
        }
      }
    },
