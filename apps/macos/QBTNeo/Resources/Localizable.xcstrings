    "Can not force reannounce if torrent is Stopped/Queued/Errored/Checking": {
      "localizations": {
        "az-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasilədə/Növbədə/Xətalı/Yoxlamada olduqda torrent təkrar məcburi anons etmək mümkün deyil"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Нельга прымусова пераанансаваць, калі торэнт спынены, у чарзе, з памылкай або правяраецца"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne može se prisilno ponovo najaviti ako je torrent zaustavljen/u redu čekanja/ima grešku/provjerava se"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No es pot forçar el reanunci si el torrent està interromput / és a la cua / té errors / es comprova."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nelze vynutit opětovné oznámení pokud je torrent ve stavu Zastaven/Ve frontě/S chybou/Kontroluji"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erzwungene erneute Anmeldung ist nicht möglich, wenn der Torrent gestoppet/in der Warteschlange/fehlerhaft/beim Überprüfen ist"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν είναι δυνατή η εξαναγκαστική επανανακοίνωση εάν το torrent είναι Σε Διακοπή/Σε Ουρά/Με Σφάλμα/Ελέγχεται"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Can not force reannounce if torrent is Stopped/Queued/Errored/Checking"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede forzar el re-anunciamiento si el torrent está detenido/en cola/con error/comprobando"
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezin da berriro iragarpena behartu torrenta Gelditu/Ilaran/Errorea/Egiaztatzen bada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de forcer la réannonce si le torrent est arrêté / en file d’attente / en erreur / en cours de vérification"
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Non se pode forzar a reanuncio se o torrent está Detido/En cola/Con erro/En comprobación"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne može se prisilno ponovno oglasiti ako je torrent Zaustavljen/U redu čekanja/Pogreška/Provjera"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kényszerített újrajelentés nem lehetséges ha a torrent állapota Leállított/Sorban áll/Hibás/Ellenőrzés alatt"
