            "value": "Passordet for nettgrensesnittet må være minst 6 tegn."
          }
        },
        "ne-NP": {
          "stringUnit": {
            "state": "translated",
            "value": "WebUI पासवर्ड कम्तिमा 6 वर्ण लामो हुनुपर्छ।"
          }
        },
        "nl": {
          "stringUnit": {
