    "Fetching of RSS feeds is disabled now! You can enable it in application settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جلب مواجز RSS مُعطل الآن! يمكنك تفعيله في إعدادات التطبيق."
          }
        },
        "az-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "RSS lentlərinin alınması indi söndürülüb! Siz onu tətbiq ayarlarında aktiv edə bilərsiniz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Атрыманне RSS-каналаў адключана! Вы можаце ўключыць яго ў наладах праграмы."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Получаването от RSS канали е изключено сега! Можете да го включите в програмните настройки."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Preuzimanje RSS feedova je sada onemogućeno! Možete ga omogućiti u postavkama aplikacije."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara l'obtenció de canals d'RSS està inhabilitada! Podeu habilitar-la als paràmetres de l'aplicació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Získávání RSS feedů je nyní vypnuto! Můžete ho zapnout v nastavení aplikace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hentning af RSS-feeds er nu deaktiveret. Du kan aktivere det i programindstillingerne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Herunterladen von RSS-Feeds ist jetzt deaktiviert! Dies kann in den Einstellungen wieder aktiviert werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ανάκτηση των ροών RSS είναι απενεργοποιημένη τώρα! Μπορείτε να την ενεργοποιήσετε στις ρυθμίσεις της εφαρμογής."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Fetching of RSS feeds is disabled now! You can enable it in application settings."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Fetching of RSS feeds is disabled now! You can enable it in application settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La busqueda por canales RSS esta deshabilitada. Puedes habilitarla en las opciones."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "RSS-voogude kättesaamine on nüüd välja lülitatud! Saate selle lubada rakenduse seadetes."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "RSS jarioak lortzea ezgaituta dago orain! Aplikazioaren ezarpenetan gaitu dezakezu."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "RSS-syötteiden haku on nyt poistettu käytöstä! Voit ottaa sen käyttöön sovellusasetuksista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La récupération de flux RSS est actuellement désactivée ! Vous pouvez l'activer depuis les paramètres de l'application."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "A busca de fontes RSS está desactivada. Pode activala nos axustes do aplicativo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משיכה של הזנות RSS מושבתת כעת! אתה יכול לאפשר אותה בהגדרות היישום."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "RSS स्रोतों को लाना अब अक्षम है! आप इसे एप्लीकेशन सेटिंग में सक्षम कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dohvaćanje RSS kanala sada je onemogućeno! Možete ga omogućiti u postavkama aplikacije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az RSS-csatornák lekérése jelenleg le van tiltva! Az alkalmazás beállításaiban engedélyezheti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengambil masukkan RSS dinonaktifkan sekarang! Anda dapat mengaktifkan di pengaturan aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il recupero delle fonti RSS è disabilitato! Puoi abilitarlo in impostazioni applicazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "RSSフィードの取得は現在無効になっています。設定から有効にできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 RSS 피드 가져오기가 비활성화되었습니다! 앱 설정에서 활성화할 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "RSS kanalų gavimas dabar yra išjungtas! Jūs galite jį įjungti programos nustatymuose."
          }
        },
        "ltg": {
          "stringUnit": {
            "state": "translated",
            "value": "RSS automatiskais atsasyuteituojs ir izslēgts! Jius tū varāt īslēgt programys īstatejumuos."
          }
        },
        "lv-LV": {
          "stringUnit": {
            "state": "translated",
            "value": "RSS kanālu lasīšana ir atslēgta! Jūs to varat ieslēgt programmas iestatījumos."
          }
        },
        "ms-MY": {
          "stringUnit": {
            "state": "translated",
            "value": "Mendapatkan suapan RSS dilumpuhkan sekarang! Anda boleh benarkannya di dalam tetapan aplikasi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisk henting av RSS-informasjonskanaler er skrudd av nå. Du kan skru det på i programinnstillingene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ophalen van RSS-feeds is nu uitgeschakeld! U kunt het inschakelen in toepassingsinstellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobieranie kanałów RSS jest teraz wyłączone! Możesz włączyć je w ustawieniach aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A busca de feeds do RSS está desativada agora! Você pode ativá-la nas configurações do programa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A procura de feeds RSS está agora desativada! Pode ativá-la nas definições da aplicação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aducerea fluxurilor RSS este dezactivată acum. Poate fi activată în configurările aplicației."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получение RSS сейчас отключено! Вы можете включить его в настройках приложения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Získanie RSS kanálov je teraz vypnuté! Môžete ho zapnúť v nastaveniach aplikácie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridobivanje RSS virov je zdaj onemogočeno! Omgočite ga lahko v nastavitvah aplikacije."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Доношење RSS фидова је сада онемогућено! Можете га омогућити у подешавањима апликације."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Donošenje RSS fidova je sada onemogućeno! Možete ga omogućiti u podešavanjima aplikacije."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hämtning av RSS-flöden är nu inaktiverad. Du kan aktivera den i programinställningarna."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "RSS bildirimlerinin getirilmesi şimdi etkisizleştirildi! Uygulama ayarlarından etkinleştirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантаження RSS-подач зараз вимкнено! Ви можете увімкнути його у налаштуваннях програми."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm nạp nguồn cấp RSS hiện đã bị vô hiệu hóa! Bạn có thể bật nó trong cài đặt ứng dụng."
          }
        },
        "zh-HK": {
          "stringUnit": {
