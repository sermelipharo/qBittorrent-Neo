    "Search engine, software updates or anything else will use proxy": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيستخدم محرك البحث أو تحديثات البرامج أو أي شيء آخر الوكيل"
          }
        },
        "az-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Axtarış mühərriki, proqram təminatı yenilənmələri və başqaları proksi istifdə edəcək"
