          "stringUnit": {
            "state": "translated",
            "value": "A WebUI jelszónak legalább 6 karakter hosszúnak kell lennie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La password WebUI deve contenere almeno 6 caratteri."
          }
        },
