    "Torrent '%@' is already in the transfer list.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Торрент «%@» уже находится в списке передач."
          }
        }
      }
    },
    "Torrent '%@' is already in the transfer list. Do you want to merge trackers from new source?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التورنت '%@' موجود بالفعل في قائمة النقل. هل تريد دمج المتتبعات من مصدر الجديد؟"
          }
        },
        "az-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Torrent '%@' artıq köçürülmə siyahısındadır. Mənbədən izləyiciləri birləçdirmək istəyirsiniz?"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Торэнт «%@» ужо ёсць у спісе. Хочаце дадаць трэкеры з новай крыніцы?"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Торент '%@' вече е в списъка за трансфер. Искате ли да обедините тракери от нов източник?"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Torrent '%@' je već na listi za prenos. Želite li spojiti trackere iz novog izvora?"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El torrent \"%@\" ja és a la llista de transferència. Voleu fuisionar els rastrejadors des d'una font nova?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Torrent '%@' již existuje v seznamu pro stažení. Přejete si sloučit trackery z nového zdroje?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Torrenten '%@' er allerede i overførselslisten. Vil du lægge trackere sammen fra den nye kilde?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Torrent '%@' befindet sich bereits in der Übertragungsliste. Sollen die Tracker von der neuen Quelle zusammengeführt werden?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το torrent '%@' υπάρχει ήδη στη λίστα λήψεων. Θέλετε να γίνει συγχώνευση των tracker από τη νέα πηγή;"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Torrent '%@' is already in the transfer list. Do you want to merge trackers from new source?"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Torrent '%@' is already in the transfer list. Do you want to merge trackers from new source?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El torrent '%@' ya está en la lista de transferencia. ¿Quieres fusionar rastreadores de una nueva fuente?"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Torrent '%@' on juba ülekandeloendis. Kas soovite jälgijaid lisada uuest allikast?"
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' torrenta transferentzia zerrendan dago jada. Iturburu berriko jarraitzaileak batu nahi dituzu?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Torrent '%@' on jo siirtolistalla. Haluatko yhdistää seurantapalvelimet uudesta lähteestä?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le torrent '%@' est déjà dans la liste des transferts. Voulez-vous fusionner les trackers de la nouvelle source ?"
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "O torrent «%@» xa está na lista de transferencias. Quere combinar os localizadores da nova fonte?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Torrent '%@' je već na popisu prijenosa. Želite li spojiti trackere iz novog izvora?"
          }
        },
        "hu": {
