    "Errors occurred when exporting .torrent files. Check execution log for details.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدثت أخطاء عند تصدير ملفات .torrent. تحقق من سجل التنفيذ للحصول على التفاصيل."
          }
        },
        "az-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Torrent faylı ixrac olunarkən xətalar baş verdi. Ətraflı məlumat üçün icra olunma jurnalına baxın."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Адбылася памылка пры экспартаванні файлаў .torrent. Праверце журнал выканання праграмы, каб паглядзець звесткі."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Грешки възникнаха при изнасяне на .torrent файлове. Проверете дневника на изпълняване за подробности."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Došlo je do grešaka prilikom izvoza .torrent datoteka. Provjerite zapisnik izvršavanja za detalje."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S'han produït errors en exportar fitxers .torrent. Consulteu el registre d'execució per obtenir més informació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Objevily se chyby při exportu .torrent souborů. Zkontrolujte Záznamy programu - Log pro podrobnosti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehler sind beim Exportieren der .torrent-Dateien aufgetreten. Bitte Ausführungs-Log für Details überprüfen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρουσιάστηκαν σφάλματα κατά την εξαγωγή αρχείων .torrent. Ελέγξτε το αρχείο καταγραφής εκτέλεσης για λεπτομέρειες."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Errors occurred when exporting .torrent files. Check execution log for details."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Errors occurred when exporting .torrent files. Check execution log for details."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocurrieron errores al exportar archivos .torrent. Consulte el registro de ejecución para obtener más información."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmnesid vead .torrent failide eksportimisega. Kontrollige toimingute logi, et näha lisainfot."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Erroreak gertatu dira .torrent fitxategiak esportatzean. Egiaztatu exekuzio erregistroa xehetasunetarako."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des erreurs se sont produites lors de l’exportation des fichiers .torrent. Consultez le journal d’exécution pour plus de détails."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Producíronse erros ao exportar ficheiros .torrent. Consulte o rexistro de execución para obter máis detalles."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Došlo je do pogreške prilikom izvoza .torrent datoteka. Za detalje provjerite zapisnik izvršenja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hibák történtek a .torrent fájlok exportálásakor. A részletekért ellenőrizze a végrehajtási naplót."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesalahan tidak diketahui ketika mengekspor file .torrent. Periksa log eksekusi untuk lebih detail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si sono verificati errori durante l'esportazione di file .torrent.\nPer i dettagli controlla il registro di esecuzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\".torrent\"ファイルのエクスポート中にエラーが発生しました。詳細は実行ログを参照してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ".torrent 파일을 내보내는 동안 오류가 발생했습니다. 자세한 내용은 실행 로그를 확인하십시오."
          }
        },
        "lv-LV": {
          "stringUnit": {
            "state": "translated",
            "value": "Radās kļūda, eksportējot .torrent failus. Vairāk informācijas reģistrā."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det oppstod feil ved eksportering av .torrent-filer. Undersøk kjøreloggen for flere detaljer."
          }
        },
        "ne-NP": {
          "stringUnit": {
            "state": "translated",
            "value": ".torrent फाइलहरू निर्यात गर्दा त्रुटिहरू भए। विवरणहरूको लागि कार्यान्वयन लग जाँच गर्नुहोस्।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn fouten opgetreden bij het exporteren van .torrent-bestanden. Controleer het uitvoeringslogboek voor details."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas eksportowania plików .torrent wystąpiły błędy. Sprawdź dziennik wykonania, aby uzyskać szczegółowe informacje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocorreram erros ao exportar os arquivos .torrent. Verifique o log de execução para detalhes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocorreram erros ao exportar os ficheiros .torrent. Verifique o registo de execução para mais detalhes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возникли ошибки при экспорте файлов .torrent. Смотрите подробности в журнале работы."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri exportovaní .torrent súborov nastali chyby. Pre detaily skontrolujte log vykonávania."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pri izvažanju datotek .torrent je prišlo do napak. Za podrobnosti glejte dnevnik izvajanja."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ndodhën gabime gjatë eksportimit të skedarëve .torrent. Kontrollo ditarin e ekzekutimit për detaje."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Грешка током извоза .torrent фајлова. Погледајте дневник за детаље."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Greška tokom izvoza .torrent fajlova. Pogledajte dnevnik za detalje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fel uppstod vid export av .torrent-filer. Kontrollera körningsloggen för detaljer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ".torrent dosyalarını dışa aktarırken hatalar meydana geldi. Ayrıntılar için çalıştırma günlüğünü gözden geçirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час експорту файлів .torrent виникли помилки. Подробиці перевірте в журналі виконання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xảy ra lỗi khi xuất tệp .torrent. Kiểm tra nhật ký thực thi để biết chi tiết."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "匯出 .torrent 檔案時發生錯誤。請檢視執行紀錄檔以取得更多資訊。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出 .torrent 文件时发生错误。详细信息请查看执行日志。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯出 .torrent 檔案時發生錯誤。請檢視執行紀錄檔以取得更多資訊。"
          }
        }
      }
