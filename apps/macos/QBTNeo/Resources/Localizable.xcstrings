    "Auto downloading of RSS torrents is currently disabled. You can enable it in application settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التنزيل التلقائي لتورنت RSS معطل حاليًا. يمكنك تفعيله في إعدادات التطبيق."
          }
        },
        "az-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "RSS torrentlərininn avtomatik endirilməsi indi söndürülüb! Siz bunu tətbiqin ayarlarında aktiv edə bilərsiniz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Аўтаспампоўванне торэнтаў з RSS у бягучы момант адключана. Вы можаце ўключыць яго ў наладах праграмы."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматичното изтегляне на RSS торенти в момента е деактивирано. Можете да го активирате в настройките на приложението."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatsko preuzimanje RSS torrenta je trenutno onemogućeno. Možete ga omogućiti u postavkama aplikacije."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualment, la baixada automàtica de torrents RSS està desactivada. Podeu activar-la a la configuració de l'aplicació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Autostahování RSS torrentů je nyní vypnuté! Můžete ho zapnout v nastavení aplikace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das automatische Herunterladen von RSS-Torrents ist derzeit deaktiviert! Dies kann in den Einstellungen wieder aktiviert werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αυτόματη λήψη torrents μέσω RSS είναι προς το παρόν απενεργοποιημένη. Μπορείτε να την ενεργοποιήσετε στις ρυθμίσεις της εφαρμογής."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto downloading of RSS torrents is currently disabled. You can enable it in application settings."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto downloading of RSS torrents is currently disabled. You can enable it in application settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La descarga automática de torrents RSS está actualmente deshabilitada. Puede habilitarlo en la configuración de la aplicación."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "RSS-torrentide automaatne allalaadimine on praegu välja lülitatud. Saate selle lubada rakenduse seadetes."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "RSS torrenten deskarga automatikoa desgaituta dago une honetan. Aplikazioaren ezarpenetan gaitu dezakezu."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "RSS-torrentien automaattinen lataaminen on tällä hetkellä kytketty pois päältä. Voit kytkeä sen päälle sovelluksen asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement automatique des torrents par flux RSS est actuellement désactivé. Vous pouvez l'activer dans les paramètres de l'application."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "A descarga automática de torrents por RSS está actualmente desactivada. Pode activala nos axustes do aplicativo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הורדה אוטומטית של טורנטי RSS מושבתת כרגע. אתה יכול לאפשר אותה בהגדרות היישום."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatsko preuzimanje RSS torrenta trenutno je onemogućeno. Možete ga omogućiti u postavkama aplikacije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az RSS torrentek automata letöltése jelenleg le van tiltva. A beállításokban engedélyezheti ezt a funkciót."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il download automatico dei torrent RSS è attualmente disabilitato.\nPuoi abilitarlo nelle impostazioni dell'applicazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "RSS Torrentの自動ダウンロードは現在、無効になっています。アプリケーションの設定で有効にできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "RSS 토렌트의 자동 다운로드는 현재 비활성화되었습니다. 앱 설정에서 활성화 설정할 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiuo metu automatinis RSS torrentų atsisiuntimas išjungtas. Jį galite įjungti programos nustatymuose."
          }
        },
        "ltg": {
          "stringUnit": {
            "state": "translated",
            "value": "RSS automatiskais atsasyuteituojs ir izslēgts! Jius tū varāt īslēgt programys īstatejumuos."
          }
        },
        "lv-LV": {
          "stringUnit": {
            "state": "translated",
            "value": "RSS automātiskais lejupielādētājs ir atslēgts! Jūs to varat ieslēgt programmas iestatījumos."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisk nedlasting av RSS-torrenter er slått av. Du kan slå det på igjen i programinnstillingene."
          }
        },
        "ne-NP": {
          "stringUnit": {
            "state": "translated",
            "value": "RSS टोरेन्टहरूको स्वतः डाउनलोड गर्ने सुविधा हाल निष्क्रिय पारिएको छ। तपाईं यसलाई एप्लिकेसन सेटिङहरूमा सक्रिय गर्न सक्नुहुन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch downloaden van RSS-torrents is momenteel uitgeschakeld. U kunt het inschakelen in de toepassingsinstellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatyczne pobieranie torrentów RSS jest obecnie wyłączone. Możesz włączyć je w ustawieniach aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O download automático dos torrents do RSS está desativado atualmente. Você pode ativá-lo nas configurações do programa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A transferência automática de torrents RSS está atualmente desativada. Pode ativá-la nas definições da aplicação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Descărcarea automată a torentelor RSS e dezactivată acum. O puteți activa în configurările programului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автозагрузка торрентов из RSS сейчас отключена! Её можно включить в настройках приложения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatické sťahovanie RSS torrentov je momentálne zakázané. Môžete ho povoliť v nastaveniach aplikácie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samodejno prejemanje torrentov RSS je trenutno onemogočeno. Omogočite ga lahko v nastavitvah programa."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Аутоматско преузимање RSS торената је тренутно онемогућено. Можете га омогућити у подешавањима апликације."
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatsko preuzimanje RSS torenata je trenutno onemogućeno. Možete ga omogućiti u podešavanjima aplikacije."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisk hämtning av RSS-torrenter är för närvarande inaktiverad. Du kan aktivera det i programinställningarna."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขณะนี้การดาวน์โหลดไฟล์ torrent จาก RSS โดยอัตโนมัติถูกปิดใช้งานอยู่ คุณสามารถเปิดใช้งานได้ในการตั้งค่าแอปพลิเคชัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "RSS torrent'lerini otomatik indirme şu anda etkisizleştirildi. Bunu uygulama ayarlarından etkinleştirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автозавантаження торрентів з RSS в даний момент вимкненно! Ви можете увімкнути його в налаштуваннях програми."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động tải xuống các torrent RSS hiện đã bị tắt. Bạn có thể bật nó trong cài đặt ứng dụng."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "RSS Torrent自動下載功能已停用。你可以到應用程式設定啟用。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动下载 RSS Torrent 功能当前被禁用。您可以在应用程序设置中启用它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前已停用自動下載 RSS 種子。您可以在應用程式設定中啟用。"
          }
        }
      }
    },
