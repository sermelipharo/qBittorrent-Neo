    "You can separate tracker tiers / groups with an empty line.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك فصل طبقات/مجموعات المتتبعات بسطر فارغ."
          }
        },
        "az-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "İzləyici səviyyələrini/qruplarını boş bir sətirlə ayırmaq olar."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Выкарыстоўвайце пустыя радкі для падзелу груп трэкераў."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Можете да разделите тракер комплекти / групи с празен ред."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Možete odvojiti nivoe/grupe trackera praznim redom."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Podeu separar els nivells de rastrejadors o grups amb una línia en blanc."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skupiny nebo třídy trackerů můžete oddělit prázdnou řádkou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan separere tracker-tiers/-grupper med en tom linje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Trackerebenen/-gruppen können mit leeren Zeilen getrennt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να διαχωρίσετε τα tiers / τις ομάδες των trackers με μια κενή γραμμή."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "You can separate tracker tiers / groups with an empty line."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You can separate tracker tiers / groups with an empty line."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes separar los niveles / grupos de trackers con una línea vacía."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Saate eraldada jälitajate tasandeid / gruppe tühja reaga."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lerro huts batekin banandu ditzakezu aztarnari mailak / taldeak."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
