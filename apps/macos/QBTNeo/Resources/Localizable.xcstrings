    "Reannounce to all trackers when IP or port changed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة الاتصال بجميع المتتبعات عند تغيير IP أو المنفذ"
          }
        },
        "az-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "İP və ya port dəyişdirildiyi zaman təkrar bildirmək"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Пераанансаваць на ўсе трэкеры пры змене IP або порта"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторно обявяване на всички тракери при промяна на IP или порт"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponovo obavijesti sve trackere kada se promijeni IP adresa ili port"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna a anunciar-ho a tots els rastrejadors quan es canviï d’IP o de port."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Znovu oznámit všem trackerům při změne IP nebo portu"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneute Benachrichtigung an alle Tracker, wenn IP oder Port geändert wurden"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Reannounce σε όλους τους trackers όταν αλλάξει η IP ή η θύρα"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-announce to all trackers when IP or port changed"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-announce to all trackers when IP or port changed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reanunciar a todos los rastreadores cuando cambia la IP o el puerto"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Koheselt teavita kõiki jälgijaid, kui IP või port on muutunud"
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beriragarri jarraitzaile guztietara IP edo ataka aldatzean"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Julkaise kaikki seurantapalvelimet uudelleen kun IP-osoite tai portti muuttuu"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réannoncer à tous les trackers lorsque l'IP ou le port a changé"
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anunciar de novo a todos os localizadores cando a IP ou o porto cambien"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכרז מחדש אל כל העוקבנים כאשר IP או פתחה השתנו"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponovno najavite svim trackerima kada se IP ili port promijeni"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Újrajelentés az összes tracker felé ha változik az IP vagy a port"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Umumkan kembali ke semua pelacak saat IP atau port diubah"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riannuncia a tutti i tracker quando l'IP o la porta sono cambiati"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "IPまたはポートに変更があったとき、すべてのトラッカーに再アナウンスする"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "IP 또는 포트가 변경되면 모든 트래커에게 다시 알림"
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakeitus IP arba prievadą, dar kartą pranešti visiems stebėjimo priemonėms"
          }
        },
        "lv-LV": {
          "stringUnit": {
            "state": "translated",
            "value": "Atjaunināt datus ar trakeriem, ja tiek mainīti IP vai porti"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Reannonser til alle sporerne når IP eller port endres"
          }
        },
        "ne-NP": {
          "stringUnit": {
            "state": "translated",
            "value": "IP वा पोर्ट परिवर्तन हुँदा सबै ट्र्याकरहरूलाई पुन: घोषणा गर्नुहोस्"
