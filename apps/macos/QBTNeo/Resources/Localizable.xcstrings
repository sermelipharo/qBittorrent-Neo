    "Use separate \"Tracker status\" filter": {
      "localizations": {
        "az-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "\"İzləyici vəziyyyəti\" süzgəci ayırıcısından istifadə edin"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristite zaseban filter \"Status trackera\""
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un filtre separat d'Estat del rastrejador"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použijte zvláštní filtr \"Stav trackeru\""
          }
        },
        "de": {
