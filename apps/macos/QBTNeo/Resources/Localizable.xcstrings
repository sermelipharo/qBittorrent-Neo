    "You can cancel the action within %lld seconds.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك إلغاء الإجراء في غضون %lld ثانية/ثوان."
          }
        },
        "az-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz bu əməli %lld saniyə ərzində ləğv edə bilərsiniz."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можаце скасаваць дзеянне на працягу %lld секунд."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Можете да откажете действието в %lld секунди."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Radnju možete otkazati u roku od %lld s sekundi."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Podeu cancel·lar aquesta acció durant %lld segons."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Můžete zrušit akci během %lld sekund."
          }
        },
