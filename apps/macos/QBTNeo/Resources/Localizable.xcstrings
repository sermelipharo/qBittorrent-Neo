          "stringUnit": {
            "state": "translated",
            "value": "Một quy tắc có tên này đã tồn tại, hãy chọn một tên khác."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "存在同名規則，請另選名稱。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该名称已被另一规则使用，请重新命名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已有這原則名稱，請選擇另一個名稱。"
          }
        }
      }
    },
    "A torrent will be considered slow if its download and upload rates stay below these values for \"Torrent inactivity timer\" seconds": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم اعتبار التورنت بطيئًا إذا ظلت معدلات التنزيل والتحميل أقل من هذه القيم لثواني \"مؤقت عدم نشاط التورنت\""
          }
        },
        "az-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir torrent endirmə və göndərmə sürəti, \"Torrent boşdayanma zamanlayıcısı\"nın saniyələrlə dəyərindən az olarsa, o, yavaş torrent hesab olunacaq"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Торэнт будзе лічыцца павольным, калі яго хуткасць спампоўвання або раздачы застаецца меншай за пазначанае значэнне на «Час бяздзейнасці торэнта»"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Торент ще бъде считан за бавен, ако скоростите му за изтегляне и качване стоят под тези стойности за \"Таймер за неактивност на торент\" секунди"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Torrent će se smatrati sporim ako mu brzine preuzimanja i otpremanja ostanu ispod ovih vrijednosti tokom \"Tajmera neaktivnosti torrenta\" sekundi"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es considerarà que un torrent és lent si les taxes de baixada i pujada es mantenen per sota d'aquests valors durant els segons del «Temporitzador d'inactivitat del torrent»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Torrent bude uznán pomalým jestliže rychlosti stahování a odesílání zůstanou pod těmito hodnotami \"Časovače nečinnosti torrentu\" v sekundách"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En torrent betrages som værende langsom hvis dens download- og uploadhastighed forbliver under disse værdier for \"Timer for torrent inaktivitet\" sekunder"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Torrent wird als langsam eingestuft, wenn die DL- und UL-Rate unterhalb der Zeitgrenze des „Timer für Torrent-Inaktivität“ bleiben"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα torrent θα θεωρηθεί αργό εάν οι ρυθμοί λήψης και αποστολής παραμείνουν κάτω από αυτές τις τιμές όσο ο «Χρόνος αδράνειας torrent» σε δευτερόλεπτα"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "A torrent will be considered slow if its download and upload rates stay below these values for \"Torrent inactivity timer\" seconds"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A torrent will be considered slow if its download and upload rates stay below these values for \"Torrent inactivity timer\" seconds"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un torrent se considerará lento si la velocidad de descarga y subida se mantienen debajo de estos valores por el tiempo indicado en el \"Temporizador de inactividad de Torrent\""
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Torrent bat astirotzat hartuko da bere jeitsiera eta igoera neurriak balio hauen azpitik badaude \"Torrent jardungabe denboragailu\" segunduz"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Torrentti tulkitaan hitaaksi, jos sen lataus- ja lähetysnopeudet pysyvät \"Torrentin passiivisuusaika\" -arvojen alla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un torrent sera considéré comme lent si ses vitesses de réception et d'envoi restent en dessous des valeurs en secondes du « Minuteur d'inactivité du torrent »"
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Un torrent considerarase lento se a descarga e o envío se manteñen por debaixo dos valores do «Temporizador de inactividade do torrent» en segundos."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טורנט ייחשב איטי אם הקצבים של הורדתו והעלאתו נשארים מתחת לערכים אלו עבור שניות \"קוצב־זמן של אי־פעילות טורנט\""
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Torrent će se smatrati sporim ako njegove stope preuzimanja i slanja ostaju ispod ovih vrijednosti za \"Odbrojavanje vremena neaktivnosti torrenta\" sekunde"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy torrent lassúnak lesz ítélve, ha a le- és feltöltési sebessége ezen értékek alatt marad a \"torrent inaktivítási időzítő\"-ben meghatározott ideig."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu torrent akan menentukan lambat jika nilai unduh dan unggah bertahan dibawah nilai ini untuk \"Timer Torrent ketidakaktifan\" detik"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un torrent sarà considerato lento se le sue velocità di download e upload resteranno sotto questi valori per \"Cronometro inattività torrent\" secondi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「Torrent非稼働中タイマー」で指定された秒数の間、ダウンロードとアップロードの速度が指定されたしきい値を下回った場合に遅いTorrentとみなされます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"토렌트 비활성 시간(초)\"동안 다운로드/업로드 속도가 이 값 이하면 느린 토렌트로 간주합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Torentas bus laikomas lėtu, jeigu per \"Torento neveiklumo laikmačio\" sekundes jo atsiuntimo ir išsiuntimo greičiai išlieka žemiau šių reikšmių"
          }
        },
        "lv-LV": {
          "stringUnit": {
            "state": "translated",
            "value": "Par lēnajiem torrentiem tiek reģistrēti tie, kuru ātrumi nepārsniedz zemāk norādītos, ilgāk kā norādīts \"Torrentu neaktivātes skaitītājā\"."
          }
        },
        "ms-MY": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebuah torrent akan dianggap perlahan jika kadar muat turun dan muat naiknya kekal di bawah nilai ini \"Torrent inactivity timer\" dalam saat"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En torrent vil bli ansett for å være treg dersom dens ned- og opp-lastingsfrekvenser holder seg under disse verdiene, i det antall sekunder som er valgt i «Torrent-inaktivitetsklokke»"
          }
        },
        "ne-NP": {
          "stringUnit": {
            "state": "translated",
            "value": "\"टोरेन्ट निष्क्रियता टाइमर\" सेकेन्डको लागि यदि यसको डाउनलोड र अपलोड दर यी मानहरू भन्दा कम रह्यो भने टोरेन्टलाई ढिलो मानिनेछ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een torrent zal als traag beschouwd worden als zijn download- en uploadsnelheden onder deze waarden blijven voor het aantal seconden in \"inactiviteitstimer van torrent\"."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Torrent będzie uważany za powolny, jeśli jego szybkość pobierania i wysyłania pozostanie poniżej tych wartości sekund \"Zegara bezczynności torrenta\""
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um torrent será considerado lento se suas taxas de download e upload ficarem abaixo destes valores pelos segundos do \"Cronômetro de inatividade do torrent\""
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um torrent será considerado lento se as taxas de transferência e envio ficarem abaixo destes valores pelos segundos do \"Temporizador de inatividade do torrent\""
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Торрент будет считаться медленным, если его скорость загрузки или отдачи будет меньше указанных значений на «Время бездействия торрента»"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Torrent bude uznaný pomalým ak rýchlosti sťahovania a odosielania zostanú pod týmito hodnotami \"Časovače nečinnosti torrentu\" v sekundách"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Torrent bo obravnavan kot počasen, če hitrosti pošiljanja in prejemanja ostaneta pod temi vrednostmi za \"Časovnik nedejavnosti torrenta\" sekund"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Торент ће се сматрати за \"спор\" ако његове брзине слања и преузимања остану испод ових вредности током периода наведеног опцијом \"Тајмер неактивности торената\""
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Torent će se smatrati za \"spor\" ako njegove brzine slanja i preuzimanja ostanu ispod ovih vrednosti tokom perioda navedenog opcijom \"Tajmer neaktivnosti torenata\""
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En torrent anses vara långsam om dess hämtnings- och sändningshastigheter ligger under dessa värden under det antal sekunder som anges av \"torrentinaktivitetstidtagare\""
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir torrent, indirme ve gönderme oranları bu \"Torrent boşta durma zamanlayıcısı\" saniye değerinin altında kalırsa yavaş sayılacaktır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торрент буде вважатися повільним, якщо його швидкість відвантаження або віддачі стане менше зазначених значень на час \"Таймера бездіяльності торрента\""
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một torrent sẽ bị xem là chậm nếu tỉ lệ tải lên và tải xuống của nó ở dưới các giá trị sau trong \"Đếm giờ torrent bất hoạt\" giây"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Torrent會被視為慢速，如果於「慢速Torrent時間」設定秒數內的上下載速度都低於設定下限值。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 Torrent 下载或上传速度低于指定阈值并持续超过 “Torrent 非活动计时器” 指定的时间时，Torrent 将会被判定为慢速。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Torrent 若下載與上傳速率在「Torrent 不活躍計時器」秒數內都低於這些值的話就會被認為是太慢了"
          }
        }
      }
    },
