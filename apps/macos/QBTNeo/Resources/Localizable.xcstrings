    "Disallow connection to peers on privileged ports": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدم السماح بالاتصال بالقرناء على المنافذ ذات الامتيازات"
          }
        },
        "az-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "İmtiyazlı portlarda iştirakçılara qoşulmanı qadağan etmək"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Забараніць злучэнне з пірамі на прывілеяваных партах"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Не разрешавай връзка към пиъри на привилегировани портове"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zabrani povezivanje s peer-ovima na privilegovanim portovima"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No permetis la connexió a clients en ports privilegiats"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepovolit připojení k peerům na privilegovaných portech"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung zu privilegierten Ports nicht zulassen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Να απαγορεύεται η σύνδεση των peers σε προνομιακές θύρες"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Disallow connection to peers on privileged ports"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Disallow connection to peers on privileged ports"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No permitir la conexión a pares en puertos privilegiados"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Keela ühendus partneritega eelistatud portidel"
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez ahalbidetu elkarketa hartzaileetara pribilegiozko ataketan"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Evää vertaisyhteydet ensisijaistettuihin portteihin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Interdire la connexion à des pairs sur des ports privilégiés"
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Non permitir conexións con pares en portos privilexiados"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אל תתיר חיבור אל עמיתים על פתחות בעלות זכויות"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zabrani povezivanje s ravnopravnim uređajima na privilegiranim portovima"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne engedje a csatlakozást peerek felé kiváltságos portokon"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non consentire la connessione a peer su porte privilegiate"
