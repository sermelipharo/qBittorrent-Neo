    "Use separate \"Tracker status\" filter. Otherwise it gets merged with \"Trackers\" filter.": {
      "localizations": {
        "az-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "\"İzləyici vəziyyəti\" süzgəci ayırıcısından istifadə edin. Əks halda o, \"İzləyicilər\" süzgəci ilə birləşdirilir."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristite zaseban filter \"Status trackera\", inače se spaja s filterom \"Trackeri\""
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un filtre separat d'Estat del rastrejador. En cas contrari, es fusionarà amb el filtre de Rastrejadors."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použijte zvláštní filtr \"Stav trackeru\". Jinak dojde ke sloučení s filtrem \"Trackery\"."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende eigenen 'Trackerstatus' Filter. Andernfalls wird es mit dem Filter 'Tracker' zusammengeführt."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Use separate \"Tracker status\" filter. Otherwise it gets merged with \"Trackers\" filter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Use el filtro \"Estado de rastreador\" por separado. De lo contrario, se fusionará con el filtro \"Rastreadores\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser un filtre distinct pour « État du tracker ». Sinon, il sera fusionné avec le filtre « Trackers »."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar un filtro separado de \"Estado do rastrexador\". Doutra forma, mestúrase co filtro \"rastrexadores\""
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristite zaseban filtar \"Status tragača\". Inače se spaja s filtrom \"Tragači\"."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Külön \"Tracker állapot\" szűrő használata. Ellenkező esetben összeolvasztásra kerül a \"Trackerek\" szűrővel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa il filtro d\"Stato tracker\" separato. Altrimenti verrà unito al filtro \"Tracker\"."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "별도의 \"트래커 상태\" 필터를 사용합니다. 그렇지 않으면 \"트래커\" 필터와 병합됩니다."
          }
        },
        "ne-NP": {
          "stringUnit": {
            "state": "translated",
            "value": "छुट्टै \"ट्र्याकर स्थिति\" फिल्टर प्रयोग गर्नुहोस्। अन्यथा यो \"ट्र्याकरहरू\" फिल्टरसँग मर्ज हुन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparte filter \"trackerstatus\" gebruiken. Anders wordt het samengevoegd met filter \"trackers\"."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj osobnego filtra „Status trackera”. W przeciwnym razie zostanie on połączony z filtrem „Trackery”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilize um filtro separado para \"Status do rastreador\". Caso contrário, ele será mesclado com o filtro \"Rastreadores\"."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizar filtro separado de \"Estado do tracker\". Caso contrário, será unido ao filtro \"Trackers\"."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать отдельный фильтр «Состояние трекера». В противном случае он будет объединён с фильтром «Трекеры»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Použite samostatný filter \"Stav trackera\". V opačnom prípade bude zlúčený s filtrom \"Trackery\"."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporabi ločen filter \"Stanje sledilnika\". V nasprotnem se združi s filtrom \"Sledilniki\"."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd ett separat filter för ”Spårarstatus”. Annars slås det samman med filtret ”Spårare”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrı bir \"İzleyici durumu\" süzgeci kullanın. Aksi takdirde \"İzleyiciler\" süzgeciyle birleştirilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте окремий фільтр «Статус трекера». Інакше він буде об'єднаний з фільтром «Трекери»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng bộ lọc \"Trạng thái máy theo dõi\" riêng biệt. Nếu không, nó sẽ được gộp với bộ lọc \"Máy theo dõi\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用独立的“追踪器状态”筛选器。否则，它会与“追踪器”筛选器同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用獨立的「Tracker 狀態」篩選器。否則它會與「Tracker 」篩選器合併。"
          }
        }
      }
    },
