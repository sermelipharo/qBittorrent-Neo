    "Are you sure you want to enable Automatic Torrent Management for the selected torrent(s)? They may be relocated.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل أنت متأكد من أنك تريد تفعيل الإدارة التلقائية للتورنت المحدد؟ قد يتم نقلهم."
          }
        },
        "az-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilmiş torrent(lər) üçün avtomatik torrent idarəetməsini aktiv etmək istədiyinizə əminsiniz? Torrentlər başqa yerə köçürülə bilər."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Сапраўды хочаце ўключыць аўтаматычнае кіраванне для выбраных торэнтаў? Яны могуць перамясціцца."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Сигурни ли сте, че искате да разрешите автоматично управление на торент за избраният/те торент(и)? Те могат да бъдат преместени."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeste li sigurni da želite omogućiti automatsko upravljanje torrentima za odabrane torrent(e)? Moguće je da će biti premješteni."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Esteu segur que voleu activar la gestió automàtica dels torrents per als torrents seleccionats? Potser es canvien d'ubicació."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jste si jistí že chcete zapnout Automatickou správu pro vybraný torrent(y)? Jejich data mohou být přemístěna."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Soll wirklich das automatische Torrent-Managment für die gewählten Torrents aktiviert werden? Diese könnten verschoben werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είστε βέβαιοι πως θέλετε να ενεργοποιήσετε την Αυτόματη Διαχείριση Torrent για τα επιλεγμένα torrent(s); Μπορεί να μετεγκατασταθούν."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to enable Automatic Torrent Management for the selected torrent(s)? They may be relocated."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to enable Automatic Torrent Management for the selected torrent(s)? They may be relocated."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Está seguro de que desea activar la administración automática de Torrent para el/los Torrent(s) seleccionados? Pueden que sean reubicados."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Oled kindel, et soovid sisselülitada automaatse torrenti halduse valitud torrenti(tele)? Nende torrentite asukohti võidakse muuta."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziur torrent kudeaketa automatikoa gaitu nahi duzula hautatutako torrente(t)an? Lekuz alda daitezke."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to Ota käyttöön Automatic Torrent Management for the valittu Torrent(s)? They may be relocated."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Êtes-vous certain de vouloir activer la gestion de torrent automatique pour le(s) torrent(s) sélectionné(s) ? Ils pourraient être déplacés."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma a activación do Xestor Automático de Torrents para os torrents seleccionado(s)? Poden ser resituados."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האם אתה בטוח שאתה רוצה לאפשר ניהול טורנטים אוטומטי עבור הטורנטים הנבחרים? ייתכן שהם ימוקמו מחדש."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
