    "Creates an additional log file after the log file reaches the specified file size": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إنشاء ملف سجل إضافي بعد أن يصل ملف السجل إلى حجم الملف المحدد"
          }
        },
        "az-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Jurnal faylı göstərilmiş ölçüyə çatdıqda sonra əlavə jurnal faylı yaradılır"
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates an additional log file after the log file reaches the specified file size"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Създава допълнителен лог файл, след като лог файлът достигне посочения файлов размер"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreira dodatnu datoteku dnevnika nakon što datoteka dnevnika dostigne određenu veličinu datoteke"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un fitxer de registre addicional després que el fitxer de registre arribi a la mida de fitxer especificada"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvoří další soubor protokolu poté, co soubor protokolu dosáhne zadané velikosti souboru"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellt eine zusätzliche Log-Datei nachdem die angegebene Größe erreicht wurde"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιουργεί ένα πρόσθετο αρχείο καταγραφής όταν η καταγραφή φτάσει το καθορισμένο μέγεθος αρχείου"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates an additional log file after the log file reaches the specified file size"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates an additional log file after the log file reaches the specified file size"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un fichero de log adicional cuando el fichero de log alcance el tamaño especificado"
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loob lisa logi faili, kui logi fail ületab valitud mahu piiri"
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohar agiri gehigarri bat sortzen du ohar agiriak adierazitako neurria erdiestean"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luo uuden tiedoston, kun nykyinen lokitiedosto ylittää tietyn tiedostokoon"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Génère un fichier journal supplémentaire lorsque le fichier journal atteint la taille spécifiée"
          }
        },
        "gl": {
          "stringUnit": {
