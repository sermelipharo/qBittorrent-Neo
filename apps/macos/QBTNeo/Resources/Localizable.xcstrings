    "Delete this API key? The current key will immediately stop working.": {
      "localizations": {
        "az-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu API açarını silək? Bu açarın işləməsi dərhal dayandırılacaq."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
