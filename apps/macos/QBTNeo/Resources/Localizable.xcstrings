    "Trackers cannot be merged because it is a private torrent.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن دمج التتبع بسبب ان التورينت خاص."
          }
        },
        "az-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "İzləyicilər birləşdirilə bilməz, çünki bu məxfi torrentdir."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Немагчыма дадаць трэкеры, бо гэта прыватны торэнт."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тракери не могат да бъдат слети, защото е частен торент."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trakeri se ne mogu spojiti jer je u pitanju privatni torrent."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els rastrejadors no es poden fusionar perquè és un torrent privat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Trackery nelze sloučit, protože jde o soukromý torrent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracker können wegen privatem Torrent nicht zusammengeführt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι trackers δεν μπορούν να ενωθούν γιατί αυτό είναι ένα private torrent"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Trackers cannot be merged because it is a private torrent."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Trackers cannot be merged because it is a private torrent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los rastreadores no pueden fusionarse porque es un torrent privado."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jälitajaid ei saa liita, kuna tegemist on privaatse torrentiga."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Aztarnariak ezin dira batu torrenta pribatua delako"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ردیاب ها را نمی توان ادغام کرد زیرا یک تورنت خصوصی است."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seurantapalvelimia ei voida yhdistää, koska torrent on yksityinen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les trackers ne peuvent pas être fusionnés car le torrent est privé"
          }
        },
