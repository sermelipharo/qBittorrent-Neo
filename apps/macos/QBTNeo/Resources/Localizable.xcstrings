    "Watched folder path cannot be empty.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن أن يكون مسار المجلد المراقب فارغًا."
          }
        },
        "az-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "İzlənilən qovluq yolu boş ola bilməz"
