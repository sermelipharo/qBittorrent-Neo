    "Generate an API key? This key can be used to interact with qBittorrent's API.": {
      "localizations": {
        "az-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir API açarı yaradaq? Bu açar qBittorrent ilə işləmək üçün istifadə oluna bilər."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Стварыць ключ API? Гэты ключ можна выкарыстоўваць для ўзаемадзеяння з API qBittorrent."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Generišete li API ključ? Ovaj ključ možete koristiti za interakciju s qBittorrent API-jem."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Voleu generar una clau d'API? Aquesta clau es pot usar per interactuar amb l'API de qBittorrent."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvořit API klíč? Klíč bude možné použít pro komunikaci s qBittorrent's API."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen API-Schlüssel generieren? Dieser Schlüssel kann zur Kommunikation mit der qBittorent-API verwendet werden."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Generate an API key? This key can be used to interact with qBittorrent's API."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Generar una clave API? Esta clave se puede usar para interactuar con la API de qBittorrent."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "luo an API avain? This avain can be used to interact with qBittorrent's API."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Générer une clé API ? Cette clé permet d'interagir avec l'API de qBittorrent."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Xerar unha clave API? Esta clave pode usarse para interactuar coa API de qBittorrent."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Generirajte API ključ? Ovaj ključ se može koristiti za interakciju s API-jem qBittorrenta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Generál egy API kulcsot? Ez a kulcs a qBittorrent API-val történő kommunikációra használható."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi generare una chiave API? \nQuesta chiave può essere usata per interagire con l'API di qBittorrent."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 키를 생성하시겠습니까? 이 키는 qBittorrent의 API와 상호 작용하는 데 사용할 수 있습니다."
          }
        },
        "ne-NP": {
          "stringUnit": {
            "state": "translated",
            "value": "API कुञ्जी उत्पन्न गर्ने हो? यो कुञ्जी qBittorrent को API सँग अन्तर्क्रिया गर्न प्रयोग गर्न सकिन्छ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een API-sleutel genereren? Deze sleutel kan worden gebruikt om te communiceren met de API van qBittorrent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wygenerować klucz API? Ten klucz może być użyty do interakcji z API qBittorrenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerar uma chave API? Esra chave pode ser usada para interagir com a API do qBittorrent."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerar uma chave API? Esta chave pode ser utilizada para interagir com a API do qBittorrent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создать ключ API? Этот ключ можно использовать для взаимодействия с API qBittorrent."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vygenerovať API kľúč? Tento kľúč bude možné použiť na komunikáciu s qBittorrent API."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Генериши API кључ? Овај кључ може да се користи за итеракцију са API-јем qBittorrent-а."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Generera en API-nyckel? Denna nyckel kan användas för att interagera med qBittorrents API."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "API anahtarı oluşturulsun mu? Bu anahtar, qBittorrent'in API'si ile etkileşimde bulunmak için kullanılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Згенерувати API-ключ? Цей ключ можна використовувати для взаємодії з API qBittorrent."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo khóa API? Khóa này có thể được sử dụng để tương tác với API của qBittorrent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成 API key 吗？这枚 key 可用于和 qBittorrent 的 API 互动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "產生 API 金鑰？這把金鑰可用於與 qBittorrent 的 API 互動。"
          }
        }
      }
    },
